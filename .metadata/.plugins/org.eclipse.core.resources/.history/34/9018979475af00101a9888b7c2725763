package arrayBidimensional;

public class ArrayBidimensional {

	public static void main(String[] args) {
		int [] [] temperatura ; // Declaración de un array bidimensional
		temperatura = new int[12] [30];
		int diaMasCaluroso = 0;
		int mesCalurosa = 0;
		
		for ( int mes = 0; mes < 12; mes++) {         // Inicialización
			for ( int dia = 0; dia < 30; dia++ ) {
			 temperatura [ mes][dia] = (int)(Math.random()*40);
				
			}
		}
		for ( int mes = 0; mes < 12; mes++) {         // Mostramos las temperaturas
			for ( int dia = 0; dia < 30; dia++ ) {
			System.out.print ( temperatura [ mes][dia] + " \t" );
			}
			System.out.println();
		}
		
	
	for ( int mes = 0; mes < 12; mes++) {        
		for ( int dia = 0; dia < 30; dia++ ) {
		   if ( diaMasCaluroso < dia) {
			   diaMasCaluroso = dia;
			   mesCalurosa = mes;
			   System.out.println( " El dia más caluroso fue el " + diaMasCaluroso + " de " + mesCalurosa);
		   }
		}
		System.out.println();   
	
}

	}
	
}